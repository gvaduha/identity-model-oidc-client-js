# Normalize all text files to LF in the repository and in every working tree,
# so Windows and Linux checkouts match each other and the build output.
* text=auto eol=lf

# Visual Studio files of the conformance harness keep the Windows convention on checkout
*.sln     text eol=crlf
*.csproj  text eol=crlf
*.config  text eol=crlf
*.cs      text eol=crlf

# Binary
*.ico     binary
*.png     binary
*.jpg     binary
*.gif     binary

# Generated bundles: don't diff or merge them line by line
/lib/**   -diff linguist-generated
/dist/**  -diff linguist-generated
/test/conformance/Oidc-Client-Conformance/Oidc-Client-Conformance/oidc-client.js -diff linguist-generated
